# Copy this file to .env.local. Leave unused services blank; never commit secrets.
# Run npm run check:setup after filling values. See SERVICE_SETUP.md for callbacks/scopes.

# Account database. Use a privileged server-only PostgreSQL role with TLS.
DATABASE_URL=
# Generate at least 32 random characters; do not reuse the encryption key below.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000

# Verification and password-recovery email. Configure a verified sender domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Optional Google account sign-in; callback: /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Private Supabase storage bucket. Never expose the service role key in NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfi-assets

# Generate exactly 32 random bytes encoded as base64. Keep this key across restarts.
INTEGRATION_ENCRYPTION_KEY=

# GitHub App OAuth credentials, separate from account sign-in.
# Callback: http://127.0.0.1:3000/api/connections/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=

# Vercel integration credentials, not the sign-in-with-Vercel app credentials.
# Redirect: http://127.0.0.1:3000/api/connections/vercel/callback
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=

# Stripe recurring prices. Use test-mode keys and prices during setup.
# Webhook endpoint: /api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Enable only after migrations and provider setup; run npm run worker:publish separately.
PUBLISH_WORKER_ENABLED=false

# Local preview is development-only. It is always disabled in production.
PORTFI_DISABLE_GUEST=false
# Optional development/test data directory; otherwise .portfi/ is used.
PORTFI_DATA_DIR=
